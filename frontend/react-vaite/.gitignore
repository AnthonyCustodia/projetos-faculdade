# Este arquivo vale para toda a pasta react-vaite.
# Os padrões abaixo são os do template do Vite, mais alguns casos que
# faltavam (segredos e caches de build).

# --- Dependências e build ---
node_modules
dist
dist-ssr
*.local
coverage/
.vite/
*.tsbuildinfo

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Segredos ---
# Variáveis de ambiente nunca entram no repositório: é o jeito mais
# comum de vazar chave de API. Se um dia precisar de um exemplo,
# crie um .env.example e versione só ele.
.env
.env.local
.env.*.local

# --- Editor ---
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Sistema operacional ---
.DS_Store
Thumbs.db
